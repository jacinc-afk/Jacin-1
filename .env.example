# RingCentral app credentials (create a "JWT auth flow" app at developers.ringcentral.com
# with the "Read Messages" and "Voicemail" scopes granted to your extension).
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# Use https://platform.devtest.ringcentral.com for a sandbox account.
RC_SERVER_URL=https://platform.ringcentral.com

# AccuLynx API key (Settings > API in AccuLynx).
ACCULYNX_API_KEY=
# Override only if your AccuLynx API base URL differs from the default.
ACCULYNX_API_BASE=https://api.acculynx.com/api/v2

# AccuLynx dropdown defaults — set these to match the values in your account.
AL_JOB_CATEGORY=Residential
AL_TRADE_TYPE=Roofing
AL_LEAD_SOURCE=Phone Call
