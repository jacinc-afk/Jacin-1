# AccuLynx API key — https://my.acculynx.com/apikeys
# This is all that's needed to run `npm run discover`.
ACCULYNX_API_KEY=
# Override only if your AccuLynx API base URL differs from the default.
ACCULYNX_API_BASE=https://api.acculynx.com/api/v2

# RingCentral app credentials. Create a private app using the JWT auth flow at
# developers.ringcentral.com with the **TeamMessaging** scope (older consoles
# label it "Glip"). Not "Read Messages" — that scope covers the message store
# (voicemail, SMS, fax), which is a different system from team chat.
#
# The JWT must be minted by a user who is a member of every channel being
# read, since the private teams are only visible to their members.
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# Use https://platform.devtest.ringcentral.com for a sandbox account.
RC_SERVER_URL=https://platform.ringcentral.com
